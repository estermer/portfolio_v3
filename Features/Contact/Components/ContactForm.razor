@rendermode InteractiveServer
@using EricstermerCom.Features.Contact.Services
@inject SubmitContact SubmitContact

@if (_submitted)
{
    <div class="contact-success card" role="status">
        <h2 class="contact-success-title">Message sent ✓</h2>
        <p>
            Thanks @_lastName — I received your note and will get back to you soon.
        </p>
        <button type="button" class="btn btn-ghost" @onclick="ResetForm">Send another</button>
    </div>
}
else
{
    <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync" FormName="contact" class="contact-form" novalidate>
        <DataAnnotationsValidator />

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="form-error" role="alert">@_error</div>
        }

        <div class="field">
            <InputText id="contact-name" class="field-input" @bind-Value="_model.Name"
                       placeholder=" " autocomplete="name" />
            <label for="contact-name" class="field-label">Name</label>
            <ValidationMessage For="() => _model.Name" class="validation-message" />
        </div>

        <div class="field">
            <InputText id="contact-email" type="email" class="field-input" @bind-Value="_model.Email"
                       placeholder=" " autocomplete="email" />
            <label for="contact-email" class="field-label">Email</label>
            <ValidationMessage For="() => _model.Email" class="validation-message" />
        </div>

        <div class="field">
            <InputTextArea id="contact-message" class="field-input field-textarea"
                           @bind-Value="_model.Message" placeholder=" " rows="5" />
            <label for="contact-message" class="field-label">Message</label>
            <ValidationMessage For="() => _model.Message" class="validation-message" />
        </div>

        <button type="submit" class="btn btn-primary submit-btn" disabled="@_submitting">
            @(_submitting ? "Sending..." : "Send message")
        </button>
    </EditForm>
}

@code {
    private readonly ContactSubmissionRequest _model = new();
    private bool _submitting;
    private bool _submitted;
    private string? _error;
    private string _lastName = string.Empty;

    private async Task HandleSubmitAsync()
    {
        _submitting = true;
        _error = null;
        try
        {
            var result = await SubmitContact.HandleAsync(_model);
            switch (result.Status)
            {
                case SubmitContactStatus.Success:
                    _lastName = _model.Name;
                    _submitted = true;
                    break;
                case SubmitContactStatus.ValidationFailed:
                    _error = result.Error;
                    break;
                default:
                    _error = $"Something went wrong: {result.Error}";
                    break;
            }
        }
        finally
        {
            _submitting = false;
        }
    }

    private void ResetForm()
    {
        _model.Name = string.Empty;
        _model.Email = string.Empty;
        _model.Message = string.Empty;
        _submitted = false;
        _error = null;
    }
}
