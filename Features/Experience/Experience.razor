@page "/experience"
@using EricstermerCom.Features.Experience.Services
@inject GetSkills GetSkills

<PageTitle>Experience · Eric Stermer</PageTitle>
<SeoMeta Title="Experience · Eric Stermer"
         Description="Languages, frameworks, tools, and methodologies Eric Stermer uses to build software."
         Path="/experience" />

<header class="experience-header">
    <h1 class="section-title">Experience</h1>
    <p class="experience-intro">
        The languages, tools, and ways of working I've used to ship software —
        from front-end frameworks to back-end services, infrastructure, and
        process.
    </p>
</header>

<section class="skill-groups">
    @foreach (var group in _groups)
    {
        <article class="card skill-group">
            <h2 class="skill-group-title">
                <span class="skill-group-dot" aria-hidden="true"></span>
                @group.Category
            </h2>
            <ul class="skill-tag-list">
                @foreach (var skill in group.Skills)
                {
                    <li class="skill-tag">@skill.Name</li>
                }
            </ul>
        </article>
    }
</section>

@code {
    private IReadOnlyList<SkillGroup> _groups = Array.Empty<SkillGroup>();

    protected override async Task OnInitializedAsync()
        => _groups = await GetSkills.HandleAsync();
}
