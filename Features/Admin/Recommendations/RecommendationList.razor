@page "/admin/recommendations"
@layout AdminLayout
@attribute [Authorize]
@rendermode InteractiveServer
@using EricstermerCom.Features.Admin.Recommendations
@inject RecommendationAdminService Service

<PageTitle>Recommendations · Admin</PageTitle>

<header class="admin-page-header">
    <h1>Recommendations</h1>
    <div class="admin-page-actions">
        <a class="admin-btn admin-btn-primary" href="/admin/recommendations/edit">+ New recommendation</a>
    </div>
</header>

@if (_recs is null)
{
    <p class="admin-empty">Loading…</p>
}
else if (!_recs.Any())
{
    <p class="admin-empty">No recommendations yet.</p>
}
else
{
    <table class="admin-table">
        <thead>
            <tr>
                <th style="width:60px">Order</th>
                <th>Author</th>
                <th>Content (excerpt)</th>
                <th style="width:180px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _recs)
            {
                <tr>
                    <td>@r.SortOrder</td>
                    <td>
                        <strong>@r.AuthorName</strong><br />
                        <span style="color:var(--text-muted); font-size:0.8125rem">@r.AuthorTitle</span>
                    </td>
                    <td>@(r.Content.Length > 120 ? r.Content[..120] + "…" : r.Content)</td>
                    <td>
                        <div class="admin-actions">
                            <a class="admin-btn" href="@($"admin/recommendations/edit/{r.Id}")">Edit</a>
                            <button type="button" class="admin-btn admin-btn-danger" @onclick="() => ConfirmDelete(r)">Delete</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (_pendingDelete is not null)
{
    <div class="confirm-overlay" role="dialog" aria-modal="true">
        <div class="confirm-card">
            <h3>Delete recommendation?</h3>
            <p>This will permanently remove the recommendation from <strong>@_pendingDelete.AuthorName</strong>.</p>
            <div class="admin-form-actions">
                <button type="button" class="admin-btn admin-btn-danger" @onclick="DeleteAsync">Delete</button>
                <button type="button" class="admin-btn" @onclick="() => _pendingDelete = null">Cancel</button>
            </div>
        </div>
    </div>
}

<style>
.confirm-overlay {
    position: fixed; inset: 0; background: rgba(41,37,36,0.45);
    display: flex; align-items: center; justify-content: center; z-index: 200;
}
.confirm-card {
    background: var(--surface); border-radius: var(--radius); padding: 1.5rem;
    max-width: 24rem; width: 90%; box-shadow: var(--shadow-hover);
}
.confirm-card h3 { margin: 0 0 0.5rem; }
.confirm-card p { margin: 0 0 1rem; color: var(--text-muted); }
</style>

@code {
    private List<Models.Recommendation>? _recs;
    private Models.Recommendation? _pendingDelete;

    protected override async Task OnInitializedAsync()
        => _recs = (await Service.ListAsync()).ToList();

    private void ConfirmDelete(Models.Recommendation rec) => _pendingDelete = rec;

    private async Task DeleteAsync()
    {
        if (_pendingDelete is null) return;
        await Service.DeleteAsync(_pendingDelete.Id);
        _recs = (await Service.ListAsync()).ToList();
        _pendingDelete = null;
    }
}
