@using EricstermerCom.Features.Projects.Services

<article class="card project-card">
    @if (!string.IsNullOrWhiteSpace(Project.Url))
    {
        <a class="project-card-image" href="@Project.Url" target="_blank" rel="noopener noreferrer">
            <img src="@Project.ImageUrl" alt="@Project.Title" loading="lazy" />
        </a>
    }
    else
    {
        <div class="project-card-image">
            <img src="@Project.ImageUrl" alt="@Project.Title" loading="lazy" />
        </div>
    }
    <div class="project-card-body">
        <h3 class="project-card-title">@Project.Title</h3>
        <p class="project-card-desc">@Project.Description</p>
        @if (Project.Tags.Any())
        {
            <ul class="project-card-tags">
                @foreach (var tag in Project.Tags)
                {
                    <li class="project-card-tag">@tag</li>
                }
            </ul>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public ProjectListItem Project { get; set; } = default!;
}
