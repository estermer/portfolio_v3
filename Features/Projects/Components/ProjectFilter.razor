@rendermode InteractiveServer
@using EricstermerCom.Features.Projects.Services
@inject GetProjects GetProjects

<section class="project-filter">
    <div class="filter-pills" role="group" aria-label="Filter projects by category">
        @foreach (var cat in _categories)
        {
            var isActive = cat == _activeCategory;
            <button type="button"
                    class="filter-pill @(isActive ? "active" : "")"
                    @onclick="() => SetCategoryAsync(cat)">
                @LabelFor(cat)
            </button>
        }
    </div>
    <p class="filter-count">
        Showing <strong>@_projects.Count</strong>
        @(_projects.Count == 1 ? "project" : "projects")
        @if (_activeCategory != "all")
        {
            <span>in <strong>@LabelFor(_activeCategory)</strong></span>
        }
    </p>
</section>

@if (_projects.Any())
{
    <div class="projects-grid">
        @foreach (var project in _projects)
        {
            <ProjectCard Project="project" />
        }
    </div>
}
else
{
    <p class="empty-state">No projects match this filter yet.</p>
}

@code {
    private const string AllCategory = "all";
    private string _activeCategory = AllCategory;
    private IReadOnlyList<string> _categories = new[] { AllCategory };
    private IReadOnlyList<ProjectListItem> _projects = Array.Empty<ProjectListItem>();

    protected override async Task OnInitializedAsync()
    {
        _categories = new[] { AllCategory }
            .Concat(await GetProjects.GetCategoriesAsync())
            .ToList();
        _projects = await GetProjects.HandleAsync();
    }

    private async Task SetCategoryAsync(string category)
    {
        _activeCategory = category;
        _projects = await GetProjects.HandleAsync(category);
    }

    private static string LabelFor(string category) => category switch
    {
        "all" => "All",
        "contributing" => "Contributing",
        "learning" => "Learning",
        "rails" => "Rails",
        "node" => "Node",
        "jquery" => "jQuery",
        _ => char.ToUpper(category[0]) + category[1..]
    };
}
