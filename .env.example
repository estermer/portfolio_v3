# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=ericstermer
POSTGRES_PASSWORD=replace-me-with-a-strong-password
POSTGRES_DB=ericstermer

# --- Admin user (created on first run if SiteUsers is empty) ---
ADMIN_EMAIL=admin@ericstermer.com
ADMIN_DISPLAY_NAME=Eric Stermer
ADMIN_PASSWORD=replace-me-with-a-strong-password

# --- Site ---
# Used by SeoMeta to build absolute og:url and canonical link tags
SITE_BASE_URL=https://ericstermer.com

# --- App ---
# Host port mapped to the container's 8080
APP_PORT=8080